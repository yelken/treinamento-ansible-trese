#!/usr/bin/env python3
"""Mostra, por nó, se o Ansible consegue falar com ele (usa o inventário interno)."""
import json
import os
import subprocess
import sys

env = dict(os.environ, ANSIBLE_CONFIG="/etc/ansible/ansible.cfg",
           ANSIBLE_STDOUT_CALLBACK="ansible.builtin.json")
proc = subprocess.run(
    ["ansible-playbook", "-i", "/opt/lab/inventory.yml", "/opt/lab/status.yml"],
    capture_output=True, text=True, env=env, check=False,
)
facts = {}
try:
    data = json.loads(proc.stdout)
    for task in data["plays"][0]["tasks"]:
        for host, res in task["hosts"].items():
            f = res.get("ansible_facts", {})
            if f:
                facts[host] = f
except (ValueError, KeyError, IndexError):
    pass

color = os.environ.get("FORCE_COLOR") == "1"
g, r, z = ("\033[32m", "\033[31m", "\033[0m") if color else ("", "", "")
bad = 0
for node in ("web1", "web2", "db1", "lb1"):
    f = facts.get(node)
    if f:
        print(f"  {g}✔{z} {node:<5} {f.get('ansible_distribution')} "
              f"{f.get('ansible_distribution_version')}  (python {f.get('ansible_python_version')})")
    else:
        print(f"  {r}✘{z} {node:<5} sem resposta do Ansible")
        bad = 1
sys.exit(bad)

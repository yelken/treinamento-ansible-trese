#!/bin/bash
# Prepara o estado inicial do desafio NN nos nós. Uso: lab-start NN
# (o `lab start` do host recria os nós antes de chamar este script)
set -uo pipefail
nn="${1:-}"
if [[ ! "$nn" =~ ^[0-9]{2}$ ]]; then
    echo "Uso: lab start NN   (ex.: lab start 01)" >&2
    exit 2
fi
script="/opt/lab/prep/$nn.sh"
if [[ ! -f "$script" ]]; then
    echo "O desafio $nn ainda não está disponível nesta versão do laboratório." >&2
    exit 2
fi
exec bash "$script"

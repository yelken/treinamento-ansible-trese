# Nó gerenciado: Debian 12 (família Debian) com systemd como PID 1.
# Contexto de build: docker/   (veja compose.yml)
FROM debian:12.15-slim

ENV container=docker \
    DEBIAN_FRONTEND=noninteractive

# Pacotes-base do nó. Nada que seja objeto dos desafios vem instalado.
# python3-apt é exigido pelo módulo ansible.builtin.apt.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates; \
    apt-get install -y --no-install-recommends \
        systemd systemd-sysv dbus openssh-server openssh-client sudo \
        python3 python3-apt iproute2 procps passwd findutils; \
    rm -rf /var/cache/apt/archives/*.deb /var/log/apt/* /var/log/dpkg.log

# Certificados de CA corporativa (proxy com inspeção TLS). Opcional: veja docker/certs/README.md
COPY certs/ /tmp/certs/
RUN set -eux; \
    for f in /tmp/certs/*.crt; do \
        [ -e "$f" ] && cp "$f" /usr/local/share/ca-certificates/ || true; \
    done; \
    update-ca-certificates; \
    rm -rf /tmp/certs

# Unidades de systemd que não fazem sentido (ou falham) dentro de um contêiner.
# apt-daily* travariam o lock do dpkg durante os desafios.
RUN systemctl mask \
        systemd-udevd.service systemd-udev-trigger.service systemd-udev-settle.service \
        systemd-udevd-control.socket systemd-udevd-kernel.socket \
        getty.target getty@.service console-getty.service \
        proc-sys-fs-binfmt_misc.automount proc-sys-fs-binfmt_misc.mount \
        dev-hugepages.mount sys-fs-fuse-connections.mount sys-kernel-config.mount \
        sys-kernel-debug.mount sys-kernel-tracing.mount \
        systemd-remount-fs.service systemd-sysctl.service systemd-binfmt.service \
        systemd-random-seed.service systemd-firstboot.service \
        apt-daily.timer apt-daily-upgrade.timer apt-daily.service apt-daily-upgrade.service \
        e2scrub_all.timer e2scrub_reap.service fstrim.timer \
    && systemctl enable ssh.service

# As chaves de host do SSH são geradas em cada contêiner novo (não herdadas da imagem).
RUN rm -f /etc/ssh/ssh_host_*_key /etc/ssh/ssh_host_*_key.pub \
    && mkdir -p /etc/systemd/system/ssh.service.d \
    && printf '[Service]\nExecStartPre=\nExecStartPre=/usr/bin/ssh-keygen -A\nExecStartPre=/usr/sbin/sshd -t\n' \
        > /etc/systemd/system/ssh.service.d/hostkeys.conf

# Usuário de automação. Sem senha; entra apenas por chave SSH (gerada pelo `lab up`).
RUN set -eux; \
    useradd --create-home --shell /bin/bash ansible; \
    usermod --password '*' ansible; \
    printf 'ansible ALL=(ALL) NOPASSWD:ALL\n' > /etc/sudoers.d/ansible; \
    chmod 0440 /etc/sudoers.d/ansible

COPY nodes/00-lab.conf /etc/ssh/sshd_config.d/00-lab.conf
RUN chmod 0600 /etc/ssh/sshd_config.d/00-lab.conf

EXPOSE 22 80
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
